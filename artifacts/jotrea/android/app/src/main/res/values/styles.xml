<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- BridgeActivity switches to this theme before loading the WebView.
             Match the cream launch surface until the stored mode is reapplied. -->
        <item name="android:statusBarColor">#FFFCF5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#101023</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ uses a centered icon, not the full-screen legacy bitmap. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/jotrea_splash_icon</item>
        <item name="windowSplashScreenBackground">#FFFCF5</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- The existing cream launch splash needs dark status icons before JS loads. -->
        <item name="android:statusBarColor">#FFFCF5</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- White navigation icons are legible on API 24–25 too. -->
        <item name="android:navigationBarColor">#101023</item>
    </style>
</resources>