modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Generate App Store Screenshots"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "jotrea-safe-area-tests"

[[workflows.workflow]]
name = "Generate App Store Screenshots"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node marketing/screenshots/generate-screenshots.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "jotrea-safe-area-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/jotrea test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
